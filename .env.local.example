# Supabase project connection.
# Get these from: Supabase Dashboard → Project Settings → API
#
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the public "anon" / "publishable" key.
# It is safe to expose to the browser — do NOT put a service_role key here.
#
# Copy this file to .env.local and fill in your project's values.
# .env.local is gitignored and must never be committed.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical/OG URL base for public landing pages (no trailing slash).
# Falls back to http://localhost:3000 in development if unset.
# Set this to the real production domain in Vercel's env settings once one exists.
NEXT_PUBLIC_SITE_URL=

# Resend (https://resend.com) — sends the admin notification email when a
# new consultation request comes in. All three optional: if any is unset,
# consultation submissions still save to the DB normally and email sending
# is silently skipped (logged server-side, never shown to the customer).
# Never prefix these with NEXT_PUBLIC_ — they must stay server-only.
#
# RESEND_API_KEY: Resend Dashboard → API Keys.
# CONSULTATION_FROM_EMAIL: a verified sender address on a domain you've
#   added and verified in Resend (e.g. notify@your-domain.com) — use the
#   exact DNS records Resend's dashboard gives you for that domain; never
#   invent DKIM/SPF/MX values here.
# CONSULTATION_NOTIFICATION_EMAIL: where new-consultation alerts are sent.
RESEND_API_KEY=
CONSULTATION_NOTIFICATION_EMAIL=
CONSULTATION_FROM_EMAIL=
