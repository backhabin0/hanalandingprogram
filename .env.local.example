# Supabase project connection.
# Get these from: Supabase Dashboard → Project Settings → API
#
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the public "anon" / "publishable" key.
# It is safe to expose to the browser — do NOT put a service_role key here.
#
# Copy this file to .env.local and fill in your project's values.
# .env.local is gitignored and must never be committed.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical/OG URL base for public landing pages (no trailing slash).
# Falls back to http://localhost:3000 in development if unset. Production
# domain is hanapage.co.kr — set this exact value in Vercel's Production
# env vars too (Project → Settings → Environment Variables), then redeploy
# (Next.js inlines NEXT_PUBLIC_ vars at build time, so saving the value
# alone does not take effect until a new build runs).
NEXT_PUBLIC_SITE_URL=https://hanapage.co.kr

# Resend (https://resend.com) — sends the admin notification email when a
# new consultation request comes in. All three optional: if any is unset,
# consultation submissions still save to the DB normally and email sending
# is silently skipped (logged server-side, never shown to the customer).
# Never prefix these with NEXT_PUBLIC_ — they must stay server-only.
#
# RESEND_API_KEY: Resend Dashboard → API Keys.
# CONSULTATION_FROM_EMAIL: a verified sender address on a domain you've
#   added and verified in Resend (e.g. notify@your-domain.com) — use the
#   exact DNS records Resend's dashboard gives you for that domain; never
#   invent DKIM/SPF/MX values here.
# CONSULTATION_NOTIFICATION_EMAIL: where new-consultation alerts are sent.
RESEND_API_KEY=
CONSULTATION_NOTIFICATION_EMAIL=
CONSULTATION_FROM_EMAIL=

# Search engine site-ownership verification (Stage 13). Both render as a
# public <meta> tag in every page's <head> — not secrets — but stay
# server-only env vars since nothing needs them in client JS. Get the value
# from each console's HTML-tag verification method (not the DNS/file
# methods) and paste only the token/content value, not the full <meta> tag.
# Unset means no verification meta is rendered; the site still works
# normally. Next.js inlines these into the built layout at build time, so a
# new Vercel Production deploy is required after setting/changing them.
#
# GOOGLE_SITE_VERIFICATION: Google Search Console → Settings → Ownership
#   verification → HTML tag method → the `content` value.
# NAVER_SITE_VERIFICATION: Naver Search Advisor → 사이트 소유확인 → HTML 태그
#   방식 → the `content` value.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
